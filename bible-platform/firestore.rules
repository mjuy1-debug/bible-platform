rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ✅ 사용자 데이터 (묵상, 즐겨찾기, 독서계획 등) - 서브컬렉션 포함
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ✅ 묵상 나눔터
    match /sharedDevotions/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.authorId;
      match /comments/{commentId} {
        allow read: if true;
        allow create, delete: if request.auth != null;
      }
    }

    // ✅ 공동 기도
    match /prayerWall/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ✅ 소그룹
    match /groups/{groupId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
      match /members/{memberId} {
        allow read, write: if request.auth != null;
      }
      match /posts/{postId} {
        allow read: if true;
        allow create: if request.auth != null;
        // 수정: 본인 글만 수정 가능 (아멘 반응은 모든 로그인 사용자 가능)
        allow update: if request.auth != null;
        // 삭제: 본인 글만 삭제 가능
        allow delete: if request.auth != null
                      && request.auth.uid == resource.data.userId;
      }
    }

    // ✅ 교회 주보 및 분할 저장
    match /bulletins/{docId}/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ✅ 말씀과 설교
    match /sermons/{docId}/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ✅ 푸시 알림 토큰
    match /fcmTokens/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if true; // 익명 기기도 토큰을 저장할 수 있도록 허용
    }
  }
}
